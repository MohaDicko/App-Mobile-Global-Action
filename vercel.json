{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "EXPO_PUBLIC_ENV=production npx expo export -p web",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/sap/:path*",
      "destination": "/api/sap?path=:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
